# Copy to .env. Never commit .env.

# Development keys expire every 24 hours: https://developer.riotgames.com
RIOT_API_KEY=

# Riot hosts. account-v1 and match-v5 are set separately because some
# regions (SEA) use a different host for each.
RIOT_ACCOUNT_REGION=europe
RIOT_MATCH_REGION=europe
# league-v4 uses the platform host, which has its own rate limit: euw1, eun1, ...
RIOT_PLATFORM_REGION=euw1

# Queues to sync: 420 = ranked solo, 440 = ranked flex.
SYNC_QUEUES=[420,440]
# Newest matches to keep across all the queues above.
SYNC_MATCH_COUNT=100

POSTGRES_USER=lolcoach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lolcoach
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
